<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- FILTER VIEW -->
        <record id="view_estate_property_search" model="ir.ui.view">
            <field name="name">estate.property.search</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <search>
                    <!-- Global search: dipakai saat user ketik di search bar -->
                    <field name="name" string="Property"/>
                    <field name="description"/>
                    <field name="property_type_id"/>
                    <field name="tag_ids"/>

                    <!-- Filter dengan domain -->
                    <filter name="available" string="Available"
                            domain="[('property_status', '=', 'available')]"/>

                    <filter name="sold" string="Sold"
                            domain="[('property_status', '=', 'sold')]"/>

                    <filter name="rented" string="Rented"
                            domain="[('property_status', '=', 'rented')]"/>

                    <!-- Filter by price range -->
                    <filter name="price_high" string="Price > 1M"
                            domain="[('price', '>', 1000000)]"/>

                    <!-- Group By -->
                    <separator/>
                    <group>
                        <filter name="group_by_type" string="Property Type"
                                context="{'group_by': 'property_type_id'}"/>
                        <filter name="group_by_status" string="Status"
                                context="{'group_by': 'property_status'}"/>
                    </group>
                </search>
            </field>
        </record>
        <!-- LIST VIEW -->
        <record id="view_estate_property_list" model="ir.ui.view">
            <field name="name">estate.property.list</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="price"/>
                    <field name="best_offer"/>
                    <field name="selling_price"/>
                    <field name="bedrooms"/>
                    <field name="bathrooms"/>
                    <field name="garages"/>
                    <field name="area"/>
                    <field name="area_unit"/>
                    <field name="total_area"/>
                    <field name="property_type_id"/>
                    <field name="tag_ids" widget="many2many_tags"/>
                    <field name="property_status"/>
                    <field name="date_availability"/>
                    <field name="date_deadline"/>
                    <field name="validity"/>
                    <field name="is_active"/>
                </list>
            </field>
        </record>

        <!-- FORM VIEW -->
        <record id="view_estate_property_form" model="ir.ui.view">
            <field name="name">estate.property.form</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group string="General Information">
                            <field name="name"/>
                            <field name="property_type_id"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                            <field name="property_status"/>
                            <field name="is_active"/>
                        </group>

                        <group string="Details">
                            <group>
                                <field name="price"/>
                                <field name="best_offer"/>
                                <field name="selling_price"/>
                                <field name="date_availability"/>
                                <field name="validity"/>
                                <field name="date_deadline"/>
                            </group>
                            <group>
                                <field name="bedrooms"/>
                                <field name="bathrooms"/>
                                <field name="garages"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Offers" name="offers">
                                <field name="offer_ids">
                                    <list>
                                        <field name="partner_id"/>
                                        <field name="price"/>
                                        <field name="date_created"/>
                                        <field name="status" widget="badge" decoration-success="status == 'accepted'" decoration-danger="status == 'refused'"/>
                                        <button name="button_accept_offer" string="Accept" type="object" class="btn-primary"/>
                                        <button name="button_refuse_offer" string="Refuse" type="object" class="btn-danger"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>

                        <group string="Area">
                            <group>
                                <field name="area"/>
                                <field name="area_unit"/>
                            </group>
                            <group>
                                <field name="living_area"/>
                                <field name="garden" />
                                <field name="garden_area"/>
                                <field name="total_area"/>
                            </group>
                        </group>

                        <group string="Description">
                            <field name="description" colspan="4"/>
                        </group>

                        <group string="Technical" colspan="4">
                            <group>
                                <field name="created_at" readonly="1"/>
                                <field name="updated_at" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_estate_property" model="ir.actions.act_window">
            <field name="name">Properties</field>
            <field name="res_model">estate.property</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_estate_property_list"/>
            <field name="search_view_id" ref="view_estate_property_search"/>
        </record>

        <!-- MENUS -->
        <menuitem id="menu_estate_root" name="Estate"/>
        <menuitem id="menu_estate_properties"
                  name="Properties"
                  parent="menu_estate_root"
                  action="action_estate_property"/>
    </data>
</odoo>