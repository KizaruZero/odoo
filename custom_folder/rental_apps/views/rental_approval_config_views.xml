<odoo>

    <record id="view_rental_approval_config_list" model="ir.ui.view">
        <field name="name">rental.approval.config.list</field>
        <field name="model">rental.approval.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="level"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_rental_approval_config_form" model="ir.ui.view">
        <field name="name">rental.approval.config.form</field>
        <field name="model">rental.approval.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="level"/>
                        <field name="user_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rental_approval_config" model="ir.actions.act_window">
        <field name="name">Approval Configuration</field>
        <field name="res_model">rental.approval.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_rental_approval_config"
              name="Approval Configuration"
              parent="menu_rental_root"
              action="action_rental_approval_config"/>

</odoo>