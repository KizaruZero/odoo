<odoo>
<record id="view_rental_asset_request_form" model="ir.ui.view">
    <field name="name">rental.asset.request.form</field>
    <field name="model">rental.asset.request.header</field>
    <field name="arch" type="xml">
        <form>
            <field name="can_approve" invisible="1"/>
            <field name="can_reject" invisible="1"/>
            <header>
                <button name="action_submit" type="object"
                        string="Submit" invisible="state != 'new' and state != 'draft'"
                        class="btn-primary"/>
                <button name="action_draft" type="object"
                        string="Draft" invisible="state != 'rejected' or create_uid != uid"
                        class="btn-secondary"/>
                <button name="action_approve" type="object"
                        string="Approve" invisible="not can_approve"
                        class="btn-success"/>
                <button name="action_reject_wizard" type="object"
                        string="Reject" invisible="not can_reject"
                        class="btn-danger"/>
                <!-- <button name="action_send_approval_reminder" type="object"
                        string="Send Approval Reminder"
                        class="btn-warning"/> -->
                <!-- Hide 'Draft' step unless record is currently in draft -->
                <field name="state" widget="statusbar"
                       statusbar_visible="new,draft,waiting,approved,rejected"
                       invisible="state != 'draft'"/>
                <field name="state" widget="statusbar"
                       statusbar_visible="new,waiting,approved,rejected"
                       invisible="state == 'draft'"/>
            </header>

            <sheet>
                <group>
                    <group>
                        <field name="name"/>
                        <field name="date" options="{'numeric': True}"/>
                        <field name="partner_id"/>
                        <field name="request_type"/>
                    </group>
                    <group>
                        <field name="required_date" options="{'numeric': True}"/>
                        <field name="notes"/>
                        <field name="attachment" filename="attachment_filename"/>
                        <field name="attachment_filename" invisible="1"/>
                    </group>
                </group>

                <notebook>

                    <page string="Line Items">
                        <field name="line_ids">
                            <list editable="bottom">
                                <field name="line_number" readonly="1"/>
                                <field name="brand_id"/>
                                <field name="model_id"/>
                                <field name="quantity"/>
                            </list>
                        </field>
                    </page>

                    <page string="Approval Stage">
                        <field name="approval_line_ids" domain="[('state','!=','')]">
                            <list>
                                <field name="level"/>
                                <field name="user_id"/>
                                <field name="state"/>
                                <field name="notes" placeholder="Add notes here..."/>
                                <field name="attachment_filename" string="Attachment"/>
                                <button name="action_download_attachment" type="object" string="Download" icon="fa-download" title="Download attachment" invisible="not attachment"/>
                                <field name="attachment"/>
                                <field name="approve_date"/>
                                <field name="reject_date"/>
                            </list>
                        </field>
                    </page>

                </notebook>
            </sheet>

            <chatter/>

        </form>
    </field>
</record>
<!-- list -->
<!-- default dari terbaru ke lama -->
<record id="view_rental_asset_request_list" model="ir.ui.view">
    <field name="name">rental.asset.request.list</field>
    <field name="model">rental.asset.request.header</field>
    <field name="arch" type="xml">
        <list default_order="date desc, id desc"
              decoration-warning="state == 'waiting'"
              decoration-danger="state == 'rejected'"
              decoration-success="state == 'approved'">
            <field name="name"/>
            <field name="date" options="{'numeric': True}"/>
            <field name="partner_id"/>
            <field name="request_type"/>
            <field name="total_qty"/>
            <field name="required_date" options="{'numeric': True}"/>
            <field name="state"/>
            <field name="notes"/>
            <field name="attachment_filename" string="Attachment"/>
            <button name="action_download_attachment" type="object" string="Download" icon="fa-download" title="Download attachment" invisible="not attachment"/>
        </list>
    </field>
</record>
<!-- action -->
<record id="action_rental_asset_request" model="ir.actions.act_window">
    <field name="name">Rental Asset Request</field>
    <field name="res_model">rental.asset.request.header</field>
    <field name="view_mode">list,form</field>
</record>

<!-- Menus -->
<menuitem id="menu_rental_root" 
          name="Rental" 
          web_icon="rental_apps,static/description/icon.png"
          action="action_rental_asset_request"
          sequence="1"/>
</odoo>