<odoo>

    <!-- Delegate Approval Configuration -->
    <record id="view_rental_delegate_approval_list" model="ir.ui.view">
        <field name="name">rental.delegate.approval.list</field>
        <field name="model">rental.delegate.approval</field>
        <field name="arch" type="xml">
            <list>
                <field name="approval_user_id"/>
                <field name="delegate_id"/>
                <field name="delegate_date"/>
                <field name="delegate_maximum_date"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <record id="view_rental_delegate_approval_form" model="ir.ui.view">
        <field name="name">rental.delegate.approval.form</field>
        <field name="model">rental.delegate.approval</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="approval_id"/>
                        <field name="approval_user_id" readonly="1"/>
                        <field name="delegate_id"/>
                    </group>
                    <group>
                        <field name="delegate_date"/>
                        <field name="delegate_maximum_date"/>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rental_delegate_approval" model="ir.actions.act_window">
        <field name="name">Delegate Approval</field>
        <field name="res_model">rental.delegate.approval</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Dropdown / submenu di bawah Approval Configuration -->
    <menuitem id="menu_rental_delegate_approval"
              name="Delegate Approval"
              parent="menu_rental_approval_config"
              action="action_rental_delegate_approval"
              sequence="20"/>

</odoo>
