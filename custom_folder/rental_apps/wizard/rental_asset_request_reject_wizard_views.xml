<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_asset_request_reject_wizard_form" model="ir.ui.view">
        <field name="name">rental.asset.request.reject.wizard.form</field>
        <field name="model">rental.asset.request.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Request">
                <group>
                    <field name="request_id" invisible="1"/>
                    <field name="notes" placeholder="Enter reason for rejection..."/>
                    <field name="attachment" filename="attachment_filename"/>
                    <field name="attachment_filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_confirm_reject" string="Confirm Reject" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
